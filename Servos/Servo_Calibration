// I am calibrating to find the proper pulse length that gives the proper 0-180 degree range I want.

//General Set-up
void setup() 
{
    Serial.begin(9600);

    pwm.begin();
    pwm.setOscillatorFrequency(27000000);
    pwm.setPWMFreq(SERVO_FREQ);  // Analog servos run at ~50 Hz updates

    delay(10);
}

void ServoMinMax() 
{
  static int servo = 0;  // persists between calls

  for (int pulselen = SERVOMINTEST; pulselen <= SERVOMAXTEST; pulselen++) {
    pwm.setPWM(servo, 0, pulselen);
    Serial.println(pulselen);
    delay(50);
  }

  delay(1000);

  for (int pulselen = SERVOMAXTEST; pulselen >= SERVOMINTEST; pulselen--) { // <-- fixed condition
    pwm.setPWM(servo, 0, pulselen);
    Serial.println(pulselen);
    delay(50);
  }

  delay(1000);

  // advance to next servo (0,1,2,0,1,2...)
  //servo++;
  //if (servo > 2) servo = 0;
} // For all 3 servos, min was 85 and max was 500.

void PotMap()
{
  int pot0 = analogRead(A0);
  int pot1 = analogRead(A1);
  int pot2 = analogRead(A2);

  int pulselen0 = map(pot0, 0, 1023, SERVOMINDEG14, SERVOMAXDEG14);
  int pulselen1 = map(pot1, 0, 1023, SERVOMINDEG15, SERVOMAXDEG15);
  int pulselen2 = map(pot2, 0, 1023, SERVOMINDEG0, SERVOMAXDEG0);

  pwm.setPWM(14, 0, pulselen0);
  pwm.setPWM(15, 0, pulselen1);
  pwm.setPWM(0, 0, pulselen2);

  Serial.print("pot0=");
  Serial.print((pot0 * 180L) / 1023);
  Serial.print(" pulselen0=");
  Serial.print(pulselen0);

  Serial.print(", pot1=");
  Serial.print((pot1 * 180L) / 1023);
  Serial.print(" pulselen1=");
  Serial.print(pulselen1);

  Serial.print(", pot2=");
  Serial.print((pot2 * 180L) / 1023);
  Serial.print(" pulselen2=");
  Serial.println(pulselen2);

  //delay(100);
}

